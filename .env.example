# Copy to .env and set real values. The real .env is never committed (Constitution, Article IX).
APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL 16 from the infra repository (plan.md §2)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=
DB_SEARCH_PATH=library

# No session, cache or queue tables: data-model.md allows only six tables
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Security (plan.md D-10, D-11)
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Covers (plan.md D-08) and CORS
COVERS_DIR=storage/app/covers
CORS_ORIGIN=http://localhost:5173
